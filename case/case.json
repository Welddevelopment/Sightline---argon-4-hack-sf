 "caseId": "HWY16FH018",
 "title": "Car into turning tractor-semitrailer at an uncontrolled median crossover, US-27A near Williston, Florida (2016)",
 "source_urls": [
  "https://www.ntsb.gov/investigations/AccidentReports/Reports/HAR1702.pdf",
  "https://www.ntsb.gov/investigations/Pages/HWY16FH018.aspx"
