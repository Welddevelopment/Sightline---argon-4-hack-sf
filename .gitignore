node_modules
.env

# raw downloaded model packs (large; curated models get copied into web/models/)
assets_src/

# demo-full: real NTSB docket PDFs/photos are fetched, not committed (manifest + extracted text only)
cases/demo-full/evidence/docket/
deposition/out_long/
case_full/render_tmp/
cases/demo-full/docket_unused/

# demo-full local run logs/raw outputs (may contain unredacted text from before redaction)
cases/demo-full/cache/extract_run.log
cases/demo-full/cache/extract_run2.log
cases/demo-full/cache/stills*.log
cases/demo-full/cache/*.raw.txt

# runtime demo clones (created by "Start demo"); demo-full is the source and stays tracked
cases/demo-*/
!cases/demo-full/

# large generated exports (rebuilt on demand)
cases/*/exports/scene.glb
cases/*/exports/scene.zip
